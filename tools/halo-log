#!/usr/bin/env python3
"""
halo-log — the journal with timestamps *and* the cover art in colour.

journalctl makes you choose. Its default formatters sanitise control
characters, which takes the colour with it and leaves a black rectangle where
the cover should be; `-o cat` keeps the escapes but drops the timestamps along
with everything else. Neither gives you both, and the art is only useful next
to the track it belongs to.

So this reads `-o json`, where the message survives intact (journald encodes a
message containing control bytes as a byte array rather than a string), and
prints the timestamp itself. Log lines get a timestamp; the art's own rows do
not, because forty consecutive identical timestamps down the left of a picture
is worse than none.

Usage:
    halo-log              last hour
    halo-log -f           follow
    halo-log -n 200       last 200 entries
    halo-log --since 14:00

Anything else is passed through to journalctl.
"""
import datetime
import json
import os
import subprocess
import sys

UNIT = "halo-daemon"
# The daemon's own lines. Everything else reaching stderr is the cover art's
# rows, which are pure escape sequences and block glyphs.
LOG_PREFIXES = ("halo:", "[halo]")


def main() -> int:
    args = sys.argv[1:]
    if not any(a in ("-f", "--follow", "-n", "--lines", "--since") for a in args):
        args = ["--since", "-1h"] + args

    cmd = ["journalctl", "-u", UNIT, "-o", "json", "--no-pager"] + args
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True)
    assert proc.stdout is not None

    try:
        for line in proc.stdout:
            try:
                entry = json.loads(line)
            except ValueError:
                continue
            message = entry.get("MESSAGE", "")
            if isinstance(message, list):
                message = bytes(message).decode("utf-8", "replace")
            if message.startswith(LOG_PREFIXES):
                stamp = datetime.datetime.fromtimestamp(
                    int(entry["__REALTIME_TIMESTAMP"]) / 1e6
                ).strftime("%H:%M:%S")
                print(f"{stamp} {message}", flush=True)
            else:
                print(message, flush=True)
    except KeyboardInterrupt:
        pass
    except BrokenPipeError:
        # Someone downstream closed the pipe — `| head`, or quitting a pager.
        # Catching it here is not enough on its own: the interpreter flushes
        # stdout again on the way out and raises a second time, which prints a
        # traceback after output the reader already stopped caring about.
        # Pointing stdout at /dev/null first is the documented way to make
        # that final flush a no-op.
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
    finally:
        proc.terminate()
    return 0


if __name__ == "__main__":
    sys.exit(main())
